# Salin ke .env lalu isi dari Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Monetisasi ---
# Nomor WhatsApp developer untuk permintaan upgrade Premium (format 628xxx).
# Tombol kontak tidak ditampilkan di iOS (aturan App Store).
EXPO_PUBLIC_UPGRADE_WHATSAPP=
# Label harga yang ditampilkan di layar Premium (Android/web), mis. "Rp50.000 / bulan per komunitas"
EXPO_PUBLIC_PREMIUM_PRICE_LABEL=

# AdMob ad unit ID untuk banner (build production). Build development memakai iklan tes.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
# AdMob App ID (dibaca app.config.js saat build; kosong = App ID tes Google)
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
